{
  "name": "poster-kit",
  "version": "1.0.0",
  "private": true,
  "description": "What Your Place and Your Sky share: undo and redo, poster sizes, typefaces, place search and the pieces of interface around them.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./files": "./src/files.ts",
    "./fonts": "./src/fonts.ts",
    "./history": "./src/history.ts",
    "./Icon": "./src/Icon.tsx",
    "./photon": "./src/photon.ts",
    "./PlaceSearch": "./src/PlaceSearch.tsx",
    "./sizes": "./src/sizes.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
